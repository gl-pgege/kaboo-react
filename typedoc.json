{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/copilotkit.ts"],
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "readme": "none",
  "gitRevision": "main",
  "githubPages": false,
  "hideBreadcrumbs": true,
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "intentionallyNotDocumented": [
    "index.ToolCall.error",
    "index.ToolCall.fix",
    "index.ToolCall.startedAt",
    "index.ToolCall.endedAt",
    "index.StreamGroup.error",
    "index.KabooProviderProps.fallbackToolRenderer",
    "index.KabooProviderProps.markdownRenderer",
    "index.KabooProviderProps.renderAgentResult",
    "index.KabooProviderProps.isReadOnlyTool",
    "index.useToolCallMeta",
    "index.ToolCallMeta",
    "index.ToolCallMeta.status",
    "index.ToolCallMeta.label",
    "index.ToolCallMeta.error",
    "index.ToolCallMeta.fix",
    "index.ToolCallMeta.startedAt",
    "index.ToolCallMeta.endedAt",
    "index.ToolCallMeta.toolCallId",
    "index.ToolCallMeta.agentName",
    "index.TimelineProps.agentName"
  ],
  "externalSymbolLinkMappings": {
    "@copilotkit/react-core": {
      "IntelligenceIndicator": "#"
    }
  },
  "treatValidationWarningsAsErrors": true
}
